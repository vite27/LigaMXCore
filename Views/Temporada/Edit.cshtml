@model LigaMXCore.Models.Temporada

@{
    ViewData["Title"] = "Editar Temporada";
    Layout = "_Layout";
}

<h1>Editar Temporada</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="TemporadaId" />

    <div class="form-group">
        <label asp-for="TemporadaNombre" class="control-label">Temporada</label>
        <input asp-for="TemporadaNombre" class="form-control" />

        <span asp-validation-for="TemporadaNombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Comentarios" class="control-label">Comentarios</label>
        <input asp-for="Comentarios" class="form-control" />

        <span asp-validation-for="Comentarios" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
