@model LigaMXCore.Models.Equipo

@{
    ViewData["Title"] = "Editar Equipo";
    Layout = "_Layout";
}

<h1>Editar Equipo</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="EquipoId" />

    <div class="form-group">
        <label asp-for="EquipoNombre" class="control-label">* Nombre del Equipo</label>
        <input asp-for="EquipoNombre" class="form-control" />

        <span asp-validation-for="EquipoNombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Alias" class="control-label">Alias</label>
        <input asp-for="Alias" class="form-control" />

        <span asp-validation-for="Alias" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EquipoLogo" class="control-label">Logo del Equipo</label>
        <input asp-for="EquipoLogo" class="form-control" />

        <span asp-validation-for="EquipoLogo" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MunicipioId" class="control-label">* Municipio</label>
        <select asp-for="MunicipioId" class="form-control" asp-items="ViewBag.MunicipioId">
            <option value="">-- Seleccione un Municipio --</option>
        </select>
        <span asp-validation-for="MunicipioId" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
