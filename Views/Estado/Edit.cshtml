@model LigaMXCore.Models.Estado

@{
    ViewData["Title"] = "Editar Estado";
    Layout = "_Layout";
}

<h1>Editar Estado</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="EstadoId" />

    <div class="form-group">
        <label asp-for="EstadoNombre" class="control-label">Nombre del Estado</label>
        <input asp-for="EstadoNombre" class="form-control" />

        <span asp-validation-for="EstadoNombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PaisId" class="control-label">País</label>
        <select asp-for="PaisId" class="form-control" asp-items="ViewBag.PaisId">
            <option value="">-- Seleccione un País --</option>
        </select>
        <span asp-validation-for="PaisId" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
