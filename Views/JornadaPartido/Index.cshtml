@model IEnumerable<LigaMXCore.Models.JornadaPartido>

@{
    ViewData["Title"] = "Partidos de la Jornada";
    Layout = "_Layout";

    var jornadaNombre = ViewData["JornadaNombre"] as string;

    // Los marcadores solo son editables si el estatus de la jornada lo permite
    // (regla definida en JornadaPartidoController.JornadaPermiteCaptura).
    var marcadoresEditables = (bool?)ViewData["MarcadoresEditables"] == true;
}

@Html.AntiForgeryToken()
<h1>Partidos de la Jornada</h1>
<p>
    <a asp-action="Index" asp-controller="Home">Volver al inicio</a>
</p>

<form method="get" asp-action="Index" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label for="jpTemporadaId" class="form-label">Temporada</label>
        <select name="temporadaId" id="jpTemporadaId" class="form-select" asp-items="ViewBag.TemporadaId">
            <option value="">Selecciona una temporada</option>
        </select>
    </div>
    <div class="col-auto">
        <label for="jpJornadaId" class="form-label">Jornada</label>
        <select name="jornadaId" id="jpJornadaId" class="form-select" asp-items="ViewBag.JornadaId">
            <option value="">Selecciona una jornada</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar filtros</a>
    </div>
</form>

@if ((bool?)ViewData["FaltaJornada"] == true)
{
    <div class="alert alert-warning">Selecciona una Temporada y una Jornada para ver sus partidos.</div>
}
else if ((bool?)ViewData["BusquedaRealizada"] == true && !Model.Any())
{
    <div class="alert alert-warning">No se encontraron partidos en la jornada seleccionada.</div>
}
else if ((bool?)ViewData["BusquedaRealizada"] != true)
{
    <div class="alert alert-info">Selecciona una Temporada y una Jornada, y presiona "Buscar" para ver el fixture.</div>
}

@if (Model.Any())
{
<h4 class="mb-3">@jornadaNombre</h4>
@if (!marcadoresEditables)
{
    <div class="alert alert-secondary py-2">
        Jornada con estatus "@ViewData["EstatusJornadaNombre"]": los marcadores son de solo lectura.
    </div>
}
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Estadio</th>
            <th>Local</th>
            <th>Marcador</th>
            <th>Visita</th>
            <th></th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (LigaMXCore.Models.JornadaPartido item in Model)
{
    <partial name="_FilaPartido" model="item" />
}
    </tbody>
</table>
}
<table>
    <td>
        <a asp-action="Add" class="btn btn-sm btn-primary">Nuevo</a>
    </td>
     <td>
        @if (marcadoresEditables)
        {
            <a asp-action="Update" class="btn btn-sm btn-primary" id="btnUpdateScores">Actualizar</a>
        }
        else
        {
            <span title="Los marcadores de esta jornada son de solo lectura" class="d-inline-block">
                <button type="button" class="btn btn-sm btn-primary" disabled>Actualizar</button>
            </span>
        }
    </td>
</table>
