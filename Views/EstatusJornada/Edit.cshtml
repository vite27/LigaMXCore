@model LigaMXCore.Models.EstatusJornada
@{
    ViewData["Title"] = "Editar Estatus Jornada";
    Layout = "_Layout";
}

<h1>Editar País</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="EstatusJornadaId" />

    <div class="form-group">
        <label asp-for="EstatusJornadaNombre" class="control-label">Estatus de la Jornada</label>
        <input asp-for="EstatusJornadaNombre" class="form-control" />
        <span asp-validation-for="EstatusJornadaNombre" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
