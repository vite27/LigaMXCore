@model LigaMXCore.Models.EstatusJornada

@{
    ViewData["Title"] = "Agregar Estatus de Jornada";
    Layout = "_Layout";
}

<h1>Agregar Estatus de Jornada</h1>

<form asp-action="Add" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <div class="form-group">
        <label asp-for="EstatusJornadaNombre" class="control-label">Estatus de Jornada</label>
        <input asp-for="EstatusJornadaNombre" class="form-control" />
        <span asp-validation-for="EstatusJornadaNombre" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Agregar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
