@model IEnumerable<LigaMXCore.Models.Estadio>

@{
    ViewData["Title"] = "Estadios";
    Layout = "_Layout";
}

<h1>Estadios</h1>
<p>
    <a asp-action="Index" asp-controller="Home">Volver al inicio</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Alias</th>
            <th>Dirección</th>
            <th>CP</th>
            <th>Municipio</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.EstadioId</td>
            <td>@item.EstadioNombre</td>
            <td>@item.Alias</td>
            <td>@item.Direccion</td>
            <td>@item.CodigoPostal</td>
            <td>@item.Municipio?.MunicipioNombre</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EstadioId" class="btn btn-sm btn-primary">Editar</a>
            </td>
        </tr>
}
    </tbody>
</table>
<table>
    <td>
        <a asp-action="Add" class="btn btn-sm btn-primary">Nuevo</a>
    </td>
</table>
