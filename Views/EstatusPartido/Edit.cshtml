@model LigaMXCore.Models.EstatusPartido
@{
    ViewData["Title"] = "Editar Estatus Partido";
    Layout = "_Layout";
}

<h1>Editar Estatus Partido</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="EstatusPartidoId" />

    <div class="form-group">
        <label asp-for="EstatusPartidoNombre" class="control-label">Estatus del Partido</label>
        <input asp-for="EstatusPartidoNombre" class="form-control" />
        <span asp-validation-for="EstatusPartidoNombre" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
