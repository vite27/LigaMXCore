@using LigaMXCore.Models
@model IEnumerable<LigaMXCore.Models.EstatusPartido>

@{
    ViewData["Title"] = "Estatus del partido";
    Layout = "_Layout";
}

<h1>@ViewData["Title"]</h1>
<p>
    <a asp-action="Index" asp-controller="Home">Volver al inicio</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Estatus</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (EstatusPartido item in Model)
{
        <tr>
            <td>@item.EstatusPartidoNombre</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.EstatusPartidoId" class="btn btn-sm btn-info">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.EstatusPartidoId" class="btn btn-sm btn-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.EstatusPartidoId" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>

<p>
    <a asp-action="Add" class="btn btn-primary">Nuevo</a>
</p>
