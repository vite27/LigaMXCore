@model LigaMXCore.Models.Municipio

@{
    ViewData["Title"] = "Editar Municipio";
    Layout = "_Layout";
}

<h1>Editar Municipio</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="MunicipioId" />

    <div class="form-group">
        <label asp-for="MunicipioNombre" class="control-label">Nombre del Municipio</label>
        <input asp-for="MunicipioNombre" class="form-control" />
        <span asp-validation-for="MunicipioNombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EstadoId" class="control-label">Estado</label>
        <select asp-for="EstadoId" class="form-control" asp-items="ViewBag.EstadoId">
            <option value="">-- Seleccione un Estado --</option>
        </select>
        <span asp-validation-for="EstadoId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
