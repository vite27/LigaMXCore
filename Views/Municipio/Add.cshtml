@model LigaMXCore.Models.Municipio

@{
    ViewData["Title"] = "Agregar Municipio";
    Layout = "_Layout";
}

<h1>Agregar Municipio</h1>

<form asp-action="Add" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="MunicipioNombre" class="control-label">* Nombre del Municipio</label>
        <input asp-for="MunicipioNombre" class="form-control" />
        <span asp-validation-for="MunicipioNombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EstadoId" class="control-label">* Estado</label>
        <select asp-for="EstadoId" class="form-control" asp-items="ViewBag.EstadoId">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="EstadoId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Agregar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
