@model IEnumerable<LigaMXCore.Models.Pais>

@{
    ViewData["Title"] = "Catálogo de Países";
    Layout = "_Layout";
}

<h1>Países</h1>

<p>
    <a asp-action="Index" asp-controller="Home">Volver al inicio</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.PaisId</td>
            <td>@item.PaisNombre</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PaisId" class="btn btn-sm btn-primary">Editar</a>
            </td>
        </tr>
}
    </tbody>
</table>
<table>
<tr>
    <td>
        <a asp-action="Add" class="btn btn-sm btn-primary">Nuevo</a>
    </td>
</tr>
</table>
